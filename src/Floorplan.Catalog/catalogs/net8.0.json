      "members": ["ExecuteSql*"], "kind": "sink", "category": "database", "payload": [{ "argument": 1, "role": "sql" }] },
    // Queries: enumerating one (foreach, ToList, First, Count, ...) runs it on the database. A DbSet is one, and so
    // is every query built on it with LINQ; FromSql* and SqlQuery* make one from SQL, which is the payload.
    { "id": "database.ef-set-query", "assembly": "Microsoft.EntityFrameworkCore", "type": "Microsoft.EntityFrameworkCore.DbSet`1",
      "members": ["*"], "kind": "query", "category": "database" },
    { "id": "database.ef-sql-query", "assembly": "Microsoft.EntityFrameworkCore.Relational", "type": "Microsoft.EntityFrameworkCore.RelationalQueryableExtensions",
