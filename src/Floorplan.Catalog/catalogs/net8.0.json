    { "id": "network.networkstream", "assembly": "System.Net.Sockets", "type": "System.Net.Sockets.NetworkStream",
      "members": ["Read", "ReadAsync", "ReadByte", "Write", "WriteAsync", "WriteByte"], "kind": "sink", "category": "network" },
    { "id": "network.dns", "assembly": "System.Net.NameResolution", "type": "System.Net.Dns",
      "members": ["GetHostEntry", "GetHostEntryAsync", "GetHostAddresses", "GetHostAddressesAsync", "Resolve", "GetHostByName", "BeginGetHost*"],
      "kind": "sink", "category": "network", "payload": [{ "argument": 0, "role": "host" }] },
    { "id": "network.ping", "assembly": "System.Net.Ping", "type": "System.Net.NetworkInformation.Ping",
