{
  // Boundary catalog for .NET 8: Microsoft.NETCore.App and Microsoft.AspNetCore.App.
  // Argument 0 in "payload" is the first declared parameter ("this" is not counted).
  "name": "net8.0",
  "rules": [
    // ---------------- http-out ----------------
    { "id": "http-out.httpclient", "assembly": "System.Net.Http", "type": "System.Net.Http.HttpClient",
      "members": ["GetAsync", "GetStringAsync", "GetByteArrayAsync", "GetStreamAsync", "PostAsync", "PutAsync", "PatchAsync", "DeleteAsync"],
      "kind": "sink", "category": "http-out", "payload": [{ "argument": 0, "role": "url" }] },
    { "id": "http-out.httpclient-send", "assembly": "System.Net.Http", "type": "System.Net.Http.HttpClient",
      "members": ["Send", "SendAsync"], "kind": "sink", "category": "http-out",
      "payload": [{ "argument": 0, "property": "RequestUri", "constructorArgument": 1, "role": "url" }] },
    { "id": "http-out.message-invoker", "assembly": "System.Net.Http", "type": "System.Net.Http.HttpMessageInvoker",
      "members": ["Send", "SendAsync"], "includeDerivedTypes": true,
      "kind": "sink", "category": "http-out",
      "payload": [{ "argument": 0, "property": "RequestUri", "constructorArgument": 1, "role": "url" }] },
    { "id": "http-out.json-extensions", "assembly": "System.Net.Http.Json", "type": "System.Net.Http.Json.HttpClientJsonExtensions",
      "members": ["GetFromJsonAsync", "GetFromJsonAsAsyncEnumerable", "PostAsJsonAsync", "PutAsJsonAsync", "PatchAsJsonAsync", "DeleteFromJsonAsync"],
      "kind": "sink", "category": "http-out", "payload": [{ "argument": 1, "role": "url" }] },
    { "id": "http-out.webclient", "assembly": "System.Net.WebClient", "type": "System.Net.WebClient",
      "members": ["Download*", "Upload*", "OpenRead*", "OpenWrite*"], "kind": "sink", "category": "http-out",
      "payload": [{ "argument": 0, "role": "url" }] },
    { "id": "http-out.webrequest", "assembly": "System.Net.Requests", "type": "System.Net.WebRequest",
      "members": ["GetResponse", "GetResponseAsync", "BeginGetResponse", "GetRequestStream", "GetRequestStreamAsync"],
      "includeDerivedTypes": true, "kind": "sink", "category": "http-out" },
    // Refit: an interface method marked [Get("/users/{id}")] (or Post, Put, Delete, Patch, Head, Options) is an HTTP
    // call when it is called; the attribute's path is the payload.
    { "id": "http-out.refit", "assembly": "Refit", "type": "Refit.HttpMethodAttribute", "members": [".ctor"], "includeDerivedTypes": true,
      "markedCalls": true, "kind": "sink", "category": "http-out", "payload": [{ "argument": 0, "role": "url" }] },
    // gRPC clients: the code Grpc.Tools generates calls a CallInvoker with the method's descriptor, a static field its
    // type's static constructor makes from the service's and the method's names ("grpc-method": the path is
    // /{service}/{method}, read as for the server's binding).
    { "id": "http-out.grpc-client", "assembly": "Grpc.Core.Api", "type": "Grpc.Core.CallInvoker",
      "members": ["BlockingUnaryCall", "AsyncUnaryCall", "AsyncServerStreamingCall", "AsyncClientStreamingCall", "AsyncDuplexStreamingCall"],
      "includeDerivedTypes": true, "kind": "sink", "category": "http-out", "payload": [{ "argument": 0, "role": "grpc-method" }] },
    // Typed HTTP clients: AddHttpClient<TClient>(configure) gives the client type ("typed-http-client" is the index of
    // the type argument) an HttpClient that the configuration delegate sets up; the constant it sets BaseAddress to
    // ("base-address") comes before the relative URLs the client sends.
    { "id": "http-out.typed-client", "assembly": "Microsoft.Extensions.Http", "type": "Microsoft.Extensions.DependencyInjection.HttpClientFactoryServiceCollectionExtensions",
      "members": ["AddHttpClient"], "kind": "registration", "category": "http-out", "payload": [{ "argument": 0, "role": "typed-http-client" }] },
    // Named clients: AddHttpClient("github", configure) ("named-http-client" is the name's argument) and the client a
    // factory makes by that name ("http-client-name").
    { "id": "http-out.named-client", "assembly": "Microsoft.Extensions.Http", "type": "Microsoft.Extensions.DependencyInjection.HttpClientFactoryServiceCollectionExtensions",
      "members": ["AddHttpClient"], "whenParameters": ["Microsoft.Extensions.DependencyInjection.IServiceCollection", "System.String"],
      "kind": "registration", "category": "http-out", "payload": [{ "argument": 1, "role": "named-http-client" }] },
    { "id": "http-out.client-factory", "assembly": "Microsoft.Extensions.Http", "type": "System.Net.Http.IHttpClientFactory",
      "members": ["CreateClient"], "includeDerivedTypes": true, "kind": "metadata", "category": "http-out",
      "payload": [{ "argument": 0, "role": "http-client-name" }] },
    { "id": "http-out.base-address", "assembly": "System.Net.Http", "type": "System.Net.Http.HttpClient",
      "members": ["set_BaseAddress"], "kind": "metadata", "category": "http-out", "payload": [{ "argument": 0, "role": "base-address" }] },
    { "id": "http-out.websocket-client", "assembly": "System.Net.WebSockets.Client", "type": "System.Net.WebSockets.ClientWebSocket",
      "members": ["ConnectAsync"], "kind": "sink", "category": "http-out", "payload": [{ "argument": 0, "role": "url" }] },

    // ---------------- network ----------------
    { "id": "network.socket", "assembly": "System.Net.Sockets", "type": "System.Net.Sockets.Socket",
