    // Entity Framework Core runs its commands through its own service container, which is not followed, so these
    // calls are the database: saving changes, raw SQL, bulk deletes and updates, and the calls that run a query.
    // A query run by enumerating it (foreach, ToList) is found through the query rules below. These name a library,
    // not the platform; EF Core versions are not tied to .NET versions, and ExecuteDelete/ExecuteUpdate moved type
    // after EF Core 8.
    { "id": "database.ef-context", "assembly": "Microsoft.EntityFrameworkCore", "type": "Microsoft.EntityFrameworkCore.DbContext",
      "members": ["SaveChanges", "SaveChangesAsync", "Find", "FindAsync"], "includeDerivedTypes": true, "kind": "sink", "category": "database" },
    { "id": "database.ef-set", "assembly": "Microsoft.EntityFrameworkCore", "type": "Microsoft.EntityFrameworkCore.DbSet`1",
      "members": ["Find", "FindAsync"], "includeDerivedTypes": true, "kind": "sink", "category": "database" },
    { "id": "database.ef-query", "assembly": "Microsoft.EntityFrameworkCore", "type": "Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions",
      "members": ["AnyAsync", "AllAsync", "CountAsync", "LongCountAsync", "ElementAtAsync", "ElementAtOrDefaultAsync", "FirstAsync", "FirstOrDefaultAsync",
                  "LastAsync", "LastOrDefaultAsync", "SingleAsync", "SingleOrDefaultAsync", "MinAsync", "MaxAsync", "SumAsync", "AverageAsync", "ContainsAsync",
