{
  // NLog.Extensions.Logging reads its configuration from here: the targets are made by reflection, from the
  // aliases their [Target] attributes give them.
  "NLog": {
    "targets": {
      "async": true,
      "relay": { "type": "Network", "address": "tcp://logs.example.org:5140" }
    },
    "rules": [ { "logger": "*", "minLevel": "Info", "writeTo": "relay" } ]
  },
  // Serilog.Settings.Configuration adds the sinks and enrichers named here by calling the methods of those names.
  // The last sink names no method there is.
  "Serilog": {
    "Using": [ "CSharp.Wrappers" ],
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Audit", "Args": { "path": "logs/audit.log" } },
      { "Name": "Contoso" }
    ]
  }
}
