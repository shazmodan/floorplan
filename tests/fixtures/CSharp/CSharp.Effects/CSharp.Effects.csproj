<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WrapperLibrary>$(MSBuildThisFileDirectory)../Dependency/CSharp.Wrappers/CSharp.Wrappers.csproj</WrapperLibrary>
    <WrapperLibraryAssembly>$(MSBuildThisFileDirectory)../Dependency/CSharp.Wrappers/bin/$(Configuration)/$(TargetFramework)/CSharp.Wrappers.dll</WrapperLibraryAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Flurl.Http" Version="4.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="log4net" Version="2.0.17" />
  </ItemGroup>
  <!-- Logging configured from XML, found next to the assembly as the libraries find it at run time. -->
  <ItemGroup>
    <None Update="nlog.config;log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The wrapper library is referenced as a built assembly, not as a project: it is a dependency, like a package,
       and not part of the solution under analysis. Built as CSharp.Delegated builds its routing library. -->
  <ItemGroup Condition="'$(TargetFramework)' != ''">
    <Reference Include="CSharp.Wrappers">
      <HintPath>$(WrapperLibraryAssembly)</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="BuildWrapperLibrary" BeforeTargets="DispatchToInnerBuilds">
    <MSBuild Projects="$(WrapperLibrary)" Targets="Restore" Properties="Configuration=$(Configuration);RestoreSeparately=true" />
    <MSBuild Projects="$(WrapperLibrary)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
  <Target Name="BuildWrapperLibraryFor" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' != '' And !Exists('$(WrapperLibraryAssembly)')">
    <MSBuild Projects="$(WrapperLibrary)" Targets="Restore" Properties="Configuration=$(Configuration);RestoreSeparately=true" />
    <MSBuild Projects="$(WrapperLibrary)" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
  </Target>
</Project>
