<?xml version="1.0" encoding="utf-8"?>
<!-- log4net makes these appenders by reflection, from their type names. The second names no type there is. -->
<log4net>
  <appender name="syslog" type="log4net.Appender.UdpAppender, log4net">
    <remoteAddress value="127.0.0.1" />
    <remotePort value="514" />
  </appender>
  <appender name="missing" type="Contoso.Logging.MissingAppender, Contoso.Logging" />
  <root>
    <level value="INFO" />
    <appender-ref ref="syslog" />
  </root>
</log4net>
