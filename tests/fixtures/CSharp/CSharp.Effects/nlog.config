<?xml version="1.0" encoding="utf-8"?>
<!-- NLog makes these targets by reflection, from the aliases their [Target] attributes give them. -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <target xsi:type="AsyncWrapper" name="async">
      <target xsi:type="WebService" name="ingest" url="https://logs.example.org/ingest" />
    </target>
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="async" />
  </rules>
</nlog>
