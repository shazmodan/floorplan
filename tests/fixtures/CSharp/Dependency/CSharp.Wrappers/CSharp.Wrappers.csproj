<Project Sdk="Microsoft.NET.Sdk">
  <!-- Not in CSharp.slnx: a wrapper library CSharp.Effects depends on, so its code is a dependency. The payloads of
       the effects behind it are worked out from its code (docs/library-payloads-plan.md). -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Compiled as packages are: optimized, so async state machines are structs started through the builder. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- A Serilog sink of its own, which CSharp.Effects adds from appsettings.json. -->
    <PackageReference Include="Serilog" Version="3.1.1" />
  </ItemGroup>
</Project>
