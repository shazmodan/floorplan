<Project Sdk="Microsoft.NET.Sdk">
  <!-- A WCF client (System.ServiceModel) of CSharp.Wcf, with its own copies of the contracts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <!-- Patched versions of what System.ServiceModel 8 references. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
  </ItemGroup>
</Project>
