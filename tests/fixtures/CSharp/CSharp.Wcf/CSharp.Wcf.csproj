<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- CoreWCF: a host exposes a service's contracts at addresses; each operation is dispatched by its action. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.2" />
    <PackageReference Include="CoreWCF.Http" Version="1.9.2" />
  </ItemGroup>
</Project>
