<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Orleans: grains are objects the silo activates and calls for clients, through proxies its source generator
       writes into the application. Here the silo and its client share one host. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" Version="8.2.0" />
  </ItemGroup>
</Project>
