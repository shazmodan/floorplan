<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RoutingLibrary>$(MSBuildThisFileDirectory)../Dependency/CSharp.Library/CSharp.Library.csproj</RoutingLibrary>
    <RoutingLibraryAssembly>$(MSBuildThisFileDirectory)../Dependency/CSharp.Library/bin/$(Configuration)/$(TargetFramework)/CSharp.Library.dll</RoutingLibraryAssembly>
  </PropertyGroup>
  <!-- The router is referenced as a built assembly, not as a project: it is a dependency, like a package, and not
       part of the solution under analysis. -->
  <ItemGroup Condition="'$(TargetFramework)' != ''">
    <Reference Include="CSharp.Library">
      <HintPath>$(RoutingLibraryAssembly)</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Built once, for every framework, before the per-framework builds run in parallel: two of them restoring
       and building the library at the same time race on its obj folder. -->
  <Target Name="BuildRoutingLibrary" BeforeTargets="DispatchToInnerBuilds">
    <MSBuild Projects="$(RoutingLibrary)" Targets="Restore" Properties="Configuration=$(Configuration);RestoreSeparately=true" />
    <MSBuild Projects="$(RoutingLibrary)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
  <!-- A build of one framework only (-f) has no outer build. -->
  <Target Name="BuildRoutingLibraryFor" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' != '' And !Exists('$(RoutingLibraryAssembly)')">
    <MSBuild Projects="$(RoutingLibrary)" Targets="Restore" Properties="Configuration=$(Configuration);RestoreSeparately=true" />
    <MSBuild Projects="$(RoutingLibrary)" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
  </Target>
</Project>
